{
  "manifest_version": 3,
  "name": "Edge 风格历史记录",
  "short_name": "Edge History",
  "version": "1.0.0",
  "description": "把 Edge 的历史记录体验带到 Chrome：按日期分组、快速搜索、时间筛选、最近关闭、跨设备标签页与批量管理。",
  "minimum_chrome_version": "116",
  "permissions": [
    "history",
    "sessions",
    "storage",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "历史记录（Alt+H）",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-history": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "Command+Shift+H"
      },
      "description": "打开完整历史记录"
    }
  }
}
